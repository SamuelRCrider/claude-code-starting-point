    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/three": "^0.180.0",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^3.2.4"
  }
}
